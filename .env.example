# Copy to .env locally; never commit or share your real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VIRUSTOTAL_API_KEY=
# Optional: absolute path to the Tesseract executable if not on PATH.
TESSERACT_CMD=
# Generate a random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Blank = local SQLite. PostgreSQL example (URL-encode credentials):
# DATABASE_URL=postgresql+psycopg://scamshield:password@localhost:5432/scamshield
DATABASE_URL=

APP_ENV=development
RATE_LIMIT_BACKEND=memory
# Comma-separated exact HTTPS Vercel origins in production, no trailing slash.
FRONTEND_ORIGINS=
# Render hostname automatically included; add other backend hostnames if needed.
ALLOWED_HOSTS=
VIRUSTOTAL_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT=100
# 1 requires a non-synthetic dataset at startup; defaults to 0 for offline demo.
REQUIRE_REAL_DATASET=0
SMS_DATASET_PATH=

# Optional verified reverse-proxy CIDRs; blank = ignore forwarded headers.
TRUSTED_PROXY_IPS=
# For local Docker Compose only; generate a random hex password (URL-safe).
POSTGRES_PASSWORD=
